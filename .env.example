# Root-level .env, read automatically by `docker compose` for variable
# substitution in docker-compose.yml / docker-compose.prod.yml (e.g. Postgres
# credentials shared between the postgres service and the api/worker services).
# This is SEPARATE from server/.env (app runtime config) and client/.env (frontend
# build-time config) - copy this to ".env" at the repo root for production deploys.
#
# Local dev with `docker compose up -d postgres redis` works with zero setup even
# without this file, since docker-compose.yml has safe defaults baked in via
# ${VAR:-default} syntax. Only needed to override those defaults in production.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=reachinbox_db
