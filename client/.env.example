# Backend API origin (no trailing slash), e.g. https://api.yourdomain.com
# Leave BLANK for local development - Vite's dev server proxies "/api" requests to
# the backend automatically (see vite.config.ts), matching the existing local setup.
# Required in production (Vercel) since there is no dev proxy there.
VITE_API_URL=

# NOTE: any variable prefixed VITE_ is bundled into the client-side JS and is
# publicly visible in the browser. Never put secrets (API keys, client secrets,
# tokens) in this file or in any VITE_ variable.
