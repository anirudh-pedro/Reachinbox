datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatar    String?
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slackIntegrations SlackIntegration[]
  emails            EmailJob[]
}

model SenderAccount {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  host         String     @default("smtp.ethereal.email")
  port         Int        @default(587)
  secure       Boolean    @default(false)
  user         String
  pass         String
  hourlyLimit  Int        @default(200)
  delaySeconds Int        @default(2)
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  emails       EmailJob[]
}

model EmailJob {
  id                 String       @id @default(uuid())
  userId             String?
  user               User?        @relation(fields: [userId], references: [id])
  senderId           String?
  sender             SenderAccount? @relation(fields: [senderId], references: [id])
  recipient          String
  subject            String
  body               String       @db.Text
  status             EmailStatus  @default(SCHEDULED)
  scheduledAt        DateTime
  sentAt             DateTime?
  jobId              String?      @unique
  batchId            String?
  delayBetweenEmails Int?         @default(2)
  hourlyLimit        Int?         @default(200)
  etherealPreviewUrl String?
  etherealMessageId  String?
  error              String?
  attempts           Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([recipient])
}

model SlackIntegration {
  id                 String   @id @default(uuid())
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  teamId             String?
  teamName           String?
  accessToken        String
  botUserId          String?
  channelId          String?
  channelName        String?
  incomingWebhookUrl String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
